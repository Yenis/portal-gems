// Headless console build of the wormhole client - phase S5's first target.
// The GUI application comes later (S6) as a separate mmp.
//
// UNVERIFIED: nothing here has been through a compiler yet. It cannot be
// until the S60 3rd FP2 SDK is in place. Treat it as a starting point.

TARGET          whmini.exe
TARGETTYPE      exe

// Unprotected UID range (0xE0000000-0xEFFFFFFF) - the range reserved for
// development and self-signed packages, which needs no allocation from
// anybody. A published app would need a protected UID we can no longer be
// issued, so this stays as it is.
UID             0 0xE1000001

// Every one of these is user-grantable, so a self-signed SIS can carry them.
// Nothing here may ever need AllFiles, ReadDeviceData or TCB: those want a
// developer certificate that can no longer be obtained.
CAPABILITY      NetworkServices ReadUserData WriteUserData

// Symbian gives a thread 8 KB of stack by default, which this program would
// overrun. The core keeps its large buffers in static structs
// (wh_mailbox_bufs, wh_xfer_bufs) precisely so the stack stays shallow, but
// 8 KB is still uncomfortably tight once the socket layer is on top.
EPOCSTACKSIZE   0x8000
EPOCHEAPSIZE    0x1000 0x400000

// The portable core. Note that vendor/tweetnacl/tweetnacl.c is deliberately
// ABSENT: src/ed25519.c compiles it inside its own translation unit to reach
// its static ed25519 internals, so listing it here as well would be a
// duplicate-symbol link error.
SOURCEPATH      ../../../native/wormhole-mini/src
SOURCE          sha256.c kdf.c box.c ed25519.c spake2.c
SOURCE          sha1.c base64.c json.c ws.c mailbox.c transit.c xfer.c

// The platform layer and the entry point.
SOURCEPATH      ../../../native/wormhole-mini/port
SOURCE          symbian.cpp
SOURCEPATH      ../src
SOURCE          main.cpp

USERINCLUDE     ../inc
USERINCLUDE     ../../../native/wormhole-mini/src
SYSTEMINCLUDE   \epoc32\include

// The core has no C library dependency at all - `grep -rn "#include <"` over
// native/wormhole-mini/src and vendor finds nothing - so this links against
// plain Symbian libraries and needs no Open C / PIPS runtime on the device.
// That is one less SIS for the user to install and one less thing to go
// wrong on a fifteen-year-old phone.
LIBRARY         euser.lib
LIBRARY         efsrv.lib
LIBRARY         esock.lib
LIBRARY         insock.lib
LIBRARY         commdb.lib
