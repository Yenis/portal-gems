// Command identifiers shared between the resource file and the code.
#ifndef WHMINI_HRH
#define WHMINI_HRH

enum TWhminiCommands
    {
    EWhminiCmdReceive = 1,
    EWhminiCmdSend,
    EWhminiCmdSendFolder,
    EWhminiCmdCancel,
    EWhminiCmdSettings,
    EWhminiCmdSetMailboxHost,
    EWhminiCmdSetMailboxPort,
    EWhminiCmdSetRelayHost,
    EWhminiCmdSetRelayPort,
    EWhminiCmdToggleDirect,
    EWhminiCmdSendText,
    EWhminiCmdShowMessage,
    EWhminiCmdAbout,
    EWhminiCmdPair,           /* cascade parents - never dispatched */
    EWhminiCmdPairedSend,
    EWhminiCmdPairedReceive,
    EWhminiCmdPairedRemove,
    EWhminiCmdPairedRename,
    EWhminiCmdPairHost,
    EWhminiCmdPairJoin,
    EWhminiCmdNoDevices,      /* placeholder shown while nothing is paired */
    EWhminiCmdSetDeviceName
    };

/* Paired-device menus are filled in when they open, one item per pairing:
 * the command is the base plus the pairing's index. Well clear of the enum
 * above and of Avkon's own command range. */
#define EWhminiCmdPairedSendBase    0x6100
#define EWhminiCmdPairedReceiveBase 0x6200
#define EWhminiCmdPairedRemoveBase  0x6300
#define EWhminiCmdPairedRenameBase  0x6400

#endif
