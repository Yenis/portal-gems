// Application resource: menu, softkeys, and the app's own name.

NAME WHMI

#include <eikon.rh>
#include <avkon.rh>
#include <avkon.rsg>
#include <avkon.hrh>
#include <appinfo.rh>
#include <CommonDialogs.rh>
#include "whmini.hrh"

RESOURCE RSS_SIGNATURE { }

RESOURCE TBUF r_default_document_name { buf = "WHMI"; }

RESOURCE EIK_APP_INFO
    {
    menubar = r_whmini_menubar;
    cba = R_AVKON_SOFTKEYS_OPTIONS_EXIT;
    }

RESOURCE MENU_BAR r_whmini_menubar
    {
    titles = { MENU_TITLE { menu_pane = r_whmini_menu; txt = "Options"; } };
    }

RESOURCE MENU_PANE r_whmini_menu
    {
    items =
        {
        MENU_ITEM { command = EWhminiCmdReceive; txt = "Receive file"; },
        MENU_ITEM { command = EWhminiCmdSend;       txt = "Send file"; },
        MENU_ITEM { command = EWhminiCmdSendFolder; txt = "Send folder"; },
        MENU_ITEM { command = EWhminiCmdSendText;   txt = "Send message"; },
        MENU_ITEM { command = EWhminiCmdShowMessage; txt = "Show message"; },
        MENU_ITEM { command = EWhminiCmdCancel;  txt = "Cancel transfer"; },
        MENU_ITEM
            {
            command = EWhminiCmdSettings;
            txt = "Settings";
            cascade = r_whmini_settings_menu;
            },
        MENU_ITEM { command = EAknSoftkeyExit;   txt = "Exit"; }
        };
    }

// The relay is a separate server from the mailbox and does not have to live
// on the same machine, so all four values are editable. Until now the relay
// host was silently copied from the mailbox host, and the ports could only
// be changed by editing server.txt on the memory card by hand.
RESOURCE MENU_PANE r_whmini_settings_menu
    {
    items =
        {
        MENU_ITEM { command = EWhminiCmdSetMailboxHost; txt = "Server address"; },
        MENU_ITEM { command = EWhminiCmdSetMailboxPort; txt = "Server port"; },
        MENU_ITEM { command = EWhminiCmdSetRelayHost;   txt = "Relay address"; },
        MENU_ITEM { command = EWhminiCmdSetRelayPort;   txt = "Relay port"; },
        MENU_ITEM { command = EWhminiCmdToggleDirect;   txt = "Direct connections"; }
        };
    }

// Memory selection for the file browser: the file dialog needs one, and
// this is the phone's own list of drives.
// The folder picker needs a file-selection resource as well as a memory
// one, because it browses into folders before settling on the one chosen.
RESOURCE FILESELECTIONDIALOG r_whmini_file_selection
    {
    title = "Select folder";
    softkey_1_file = "Select";
    softkey_1_folder = "Open";
    softkey_2_root_level = "Cancel";
    softkey_2_subfolder = "Back";
    }

RESOURCE MEMORYSELECTIONDIALOG r_whmini_memory_selection
    {
    title = "Select memory";
    softkey_1 = "Select";
    softkey_2 = "Cancel";
    }

// A message is longer than a server address, so it gets its own query with a
// taller editor rather than the stock single-line one. maxlength is in
// characters as typed; the byte length after UTF-8 conversion is checked
// again before the message goes anywhere near the wire.
RESOURCE DIALOG r_whmini_text_query
    {
    flags = EGeneralQueryFlags;
    buttons = R_AVKON_SOFTKEYS_OK_CANCEL;
    items =
        {
        DLG_LINE
            {
            type = EAknCtQuery;
            id = EGeneralQuery;
            control = AVKON_DATA_QUERY
                {
                layout = EDataLayout;
                label = "Message";
                control = EDWIN
                    {
                    flags = EEikEdwinNoHorizScrolling | EEikEdwinResizable;
                    width = 20;
                    lines = 5;
                    maxlength = 400;
                    };
                };
            }
        };
    }

// A received message can be longer than the main screen's seven lines, so it
// is shown in a dialog that scrolls.
RESOURCE DIALOG r_whmini_message_query
    {
    // No heading pane: AVKON_HEADING defaults `headinglayout` to an Avkon
    // resource this file cannot link against, and rcomp reports that as a
    // bare "Link name not found". The screen underneath already says a
    // message arrived, so the dialog only has to show it.
    flags = EGeneralQueryFlags | EEikDialogFlagNoDrag;
    buttons = R_AVKON_SOFTKEYS_OK_EMPTY;
    items =
        {
        DLG_LINE
            {
            type = EAknCtMessageQuery;
            id = EAknMessageQueryContentId;
            control = AVKON_MESSAGE_QUERY { };
            }
        };
    }
