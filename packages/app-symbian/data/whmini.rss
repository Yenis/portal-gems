// Application resource: menu, softkeys, and the app's own name.

NAME WHMI

#include <eikon.rh>
#include <avkon.rh>
#include <avkon.rsg>
#include <avkon.hrh>
#include <appinfo.rh>
#include <CommonDialogs.rh>
#include "whmini.hrh"

RESOURCE RSS_SIGNATURE { }

RESOURCE TBUF r_default_document_name { buf = "WHMI"; }

RESOURCE EIK_APP_INFO
    {
    menubar = r_whmini_menubar;
    cba = R_AVKON_SOFTKEYS_OPTIONS_EXIT;
    }

RESOURCE MENU_BAR r_whmini_menubar
    {
    titles = { MENU_TITLE { menu_pane = r_whmini_menu; txt = "Options"; } };
    }

RESOURCE MENU_PANE r_whmini_menu
    {
    items =
        {
        MENU_ITEM { command = EWhminiCmdReceive; txt = "Receive file"; },
        MENU_ITEM { command = EWhminiCmdSend;    txt = "Send file"; },
        MENU_ITEM { command = EWhminiCmdCancel;  txt = "Cancel transfer"; },
        MENU_ITEM
            {
            command = EWhminiCmdSettings;
            txt = "Settings";
            cascade = r_whmini_settings_menu;
            },
        MENU_ITEM { command = EAknSoftkeyExit;   txt = "Exit"; }
        };
    }

// The relay is a separate server from the mailbox and does not have to live
// on the same machine, so all four values are editable. Until now the relay
// host was silently copied from the mailbox host, and the ports could only
// be changed by editing server.txt on the memory card by hand.
RESOURCE MENU_PANE r_whmini_settings_menu
    {
    items =
        {
        MENU_ITEM { command = EWhminiCmdSetMailboxHost; txt = "Server address"; },
        MENU_ITEM { command = EWhminiCmdSetMailboxPort; txt = "Server port"; },
        MENU_ITEM { command = EWhminiCmdSetRelayHost;   txt = "Relay address"; },
        MENU_ITEM { command = EWhminiCmdSetRelayPort;   txt = "Relay port"; }
        };
    }

// Memory selection for the file browser: the file dialog needs one, and
// this is the phone's own list of drives.
RESOURCE MEMORYSELECTIONDIALOG r_whmini_memory_selection
    {
    title = "Select memory";
    softkey_1 = "Select";
    softkey_2 = "Cancel";
    }
