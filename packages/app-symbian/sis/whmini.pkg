; Package definition for the headless PortalGems client.
;
; Built and signed by scripts/symbian-sign.sh, which generates a self-signed
; certificate on first use. Self-signing is sufficient because every
; capability in whmini.mmp is user-grantable. The phone needs:
;   Menu > Settings > App. manager > Software installation = All
;   Menu > Settings > App. manager > Online certif. check  = Off
;
; Section order matters: the language block has to come before the package
; header, or makesis reports "the languages have already been defined".

; Languages
&EN

; Name, package UID (matches whmini.mmp), major, minor, build, type
#{"PortalGems Mini"}, (0xE1000001), 0, 3, 1, TYPE=SA

; Vendor: unique name, then the localised one
%{"PortalGems"}
:"PortalGems"

; Platform dependency. Without one, the installer cannot confirm the package
; suits the device and warns "not compatible with phone, install anyway?" -
; it installs if confirmed, but the warning is alarming and avoidable.
; S60 3rd Edition feature pack UIDs:
;   0x101F7961  S60 3rd Edition
;   0x102032BE  S60 3rd Edition FP1
;   0x102752AE  S60 3rd Edition FP2   <- the E72
[0x102752AE], 0, 0, 0, {"Series60ProductID"}

; Source path is relative to this file. scripts/symbian-sign.sh copies the
; built binary here first, so the package does not hard-code an EPOCROOT
; that differs on every machine.
"whmini.exe" - "!:\sys\bin\whmini.exe"

; Application registration. These two are what put the app in the menu:
; without them the executable installs to \sys\bin and is invisible, listed
; under App. manager as an installed package but impossible to launch.
"whmini.rsc" - "!:\resource\apps\whmini.rsc"
"whmini_reg.rsc" - "!:\private\10003a3f\import\apps\whmini_reg.rsc"
"whmini_loc.rsc" - "!:\resource\apps\whmini_loc.rsc"
